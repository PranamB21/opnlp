# Copy to .env and `set -a; source .env; set +a` before starting the NLP service.

# LLM provider for structured extraction: auto | anthropic | openai | mock
NLP_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Rolling window (seconds)
NLP_WINDOW_SECONDS=40
NLP_MIN_WINDOW_SECONDS=20
NLP_MAX_WINDOW_SECONDS=90
NLP_PAUSE_GAP_SECONDS=2.5

# Slack incoming webhook for the "End meeting" button
SLACK_WEBHOOK_URL=

# Service wiring
WLK_WS_URL=ws://localhost:8000/asr
NLP_PORT=8001